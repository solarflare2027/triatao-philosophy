* text=auto
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.mp4 binary
*.jpg binary
*.png binary
*.webp binary
*.woff2 binary
*.ttf binary
*.otf binary

# Preserve deployed bytes, including Windows line endings used by snapshot hashes.
dist/** -text whitespace=cr-at-eol
